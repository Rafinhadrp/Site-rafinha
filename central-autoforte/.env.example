# Copie estes nomes para o Vercel: Project → Settings → Environment Variables
# (não coloque os valores reais neste arquivo)

# Senha para usar a aba Consultas (escolha uma senha forte)
CENTRAL_SENHA=

# Tokens da APIBrasil (área do cliente APIBrasil)
APIBRASIL_BEARER_TOKEN=
APIBRASIL_DEVICE_TOKEN=

# Opcional: DeviceToken diferente para um serviço específico
# APIBRASIL_DEVICE_TOKEN_PLACA=
# APIBRASIL_DEVICE_TOKEN_DEBITOS=
# APIBRASIL_DEVICE_TOKEN_FIPE=
# APIBRASIL_DEVICE_TOKEN_CNPJ=
# APIBRASIL_DEVICE_TOKEN_CPF=
# APIBRASIL_DEVICE_TOKEN_CEP=
